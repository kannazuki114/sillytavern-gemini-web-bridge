{
  "name": "sillytavern-gemini-web-bridge",
  "version": "1.1.0",
  "private": true,
  "description": "SillyTavern server plugin for a local Gemini web session through Chrome CDP",
  "type": "module",
  "main": "index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/regressions.mjs && node test/page-scripts.mjs",
    "start": "node server.mjs",
    "start:echo": "node server.mjs --backend echo"
  },
  "devDependencies": {
    "express": "^4.22.3"
  }
}
